# Environment for the mongot systemd service.
# Anything in MONGOT_OPTS is appended to the mongot command line.
# Example: pass extra JVM flags via the mongot launcher.
#MONGOT_OPTS="--jvm-flags '-Xmx4g'"
MONGOT_OPTS=""

# JNI libraries are extracted here and dlopened, so this cannot sit on a noexec
# mount. RHEL 8 mounts /tmp noexec, hence the override.
TMPDIR=/var/lib/mongot/tmp
